import { Button, ComboBox } from "std-widgets.slint";

export struct ExportSelection {
    quality: int,
    canvas: int,
}

export component ExportSettings inherits PopupWindow {
    callback accepted(ExportSelection);
    in-out property <int> quality-index;
    in-out property <int> canvas-index;

    width: 360px;
    height: 224px;
    close-policy: PopupClosePolicy.no-auto-close;
    forward-focus: quality;

    Rectangle {
        background: #252e42;
        border-radius: 8px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: start;
            Text { text: "MP4 の書き出し設定"; font-size: 17px; font-weight: 700; color: #e8edfa; }
            Text { text: "画質"; color: #e8edfa; }
            quality := ComboBox {
                accessible-label: "画質";
                model: ["標準", "高画質", "容量優先"];
                current-index <=> root.quality-index;
            }
            Text { text: "縦横比"; color: #e8edfa; }
            canvas := ComboBox {
                accessible-label: "縦横比";
                model: ["元の映像に合わせる", "横長 16:9 (1280 × 720)", "縦長 9:16 (720 × 1280)"];
                current-index <=> root.canvas-index;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "キャンセル"; clicked => { root.close(); } }
                Button {
                    text: "保存先を選ぶ";
                    primary: true;
                    clicked => {
                        root.close();
                        root.accepted({ quality: quality.current-index, canvas: canvas.current-index });
                    }
                }
            }
        }
    }
}
